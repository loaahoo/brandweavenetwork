# Copy to .env.local. Never commit real values.

# PostgreSQL (Neon, Supabase, RDS…) — used by Prisma once the store is swapped for the database.
# Pooled connection (host contains "-pooler") — used by the running app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
# Direct (unpooled) connection — used only by `prisma migrate`.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# Auth provider with organization support (Clerk or Auth.js). Not wired yet.
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# S3-compatible object storage for assets and Deal Room files.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Email (Resend) and payments (Stripe / Stripe Connect).
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
